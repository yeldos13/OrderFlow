{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "OrderFlow.Consumer"
    }
  },
  "Kafka": {
    "ClientId": "orderflow-consumer",
    "GroupId": "orderflow-warehouse-sync",
    "Topic": "orderflow.orders"
  },
  "Warehouse": {
    "Timeout": "00:00:05"
  },
  "Deduplication": {
    "Retention": "14.00:00:00",
    "CleanupInterval": "01:00:00"
  },
  "AllowedHosts": "*"
}
