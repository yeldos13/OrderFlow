{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "OrderFlow.Consumer"
    }
  },
  "Kafka": {
    "ClientId": "orderflow-consumer",
    "GroupId": "orderflow-warehouse-sync",
    "Topic": "orderflow.orders"
  },
  "Warehouse": {
    "Resilience": {
      "TotalTimeout": "00:00:30",
      "AttemptTimeout": "00:00:02",
      "MaxRetryAttempts": 4,
      "RetryBaseDelay": "00:00:00.500",
      "CircuitFailureRatio": 0.5,
      "CircuitMinimumThroughput": 10,
      "CircuitSamplingDuration": "00:00:30",
      "CircuitBreakDuration": "00:00:15"
    }
  },
  "Deduplication": {
    "Retention": "14.00:00:00",
    "CleanupInterval": "01:00:00"
  },
  "AllowedHosts": "*"
}
