{
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Warehouse": {
    "BaseUrl": "http://localhost:5210"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {TraceId}{NewLine}{Exception}"
        }
      }
    ]
  }
}
